# .env.example — 复制为 .env 并填写真实值
# 不要把 .env 提交到 git

# 数据库（阿里云 RDS MySQL / PolarDB）
DATABASE_URL="mysql://user:password@host:3306/ai_pet"

# JWT 签名密钥（随机 32 位字符串）
JWT_SECRET="replace-with-random-secret-32chars"
JWT_EXPIRES_IN="30d"

# 微信小程序
WX_APP_ID="your_wx_appid"
WX_APP_SECRET="your_wx_appsecret"

# 阿里云 OSS
OSS_REGION="oss-cn-hangzhou"
OSS_BUCKET="ai-pet-images"
OSS_ACCESS_KEY_ID="your_access_key_id"
OSS_ACCESS_KEY_SECRET="your_access_key_secret"
OSS_CDN_BASE="https://your-cdn-domain.com"  # OSS 绑定的 CDN 域名

# 通义万相 API（阿里云 DashScope）
DASHSCOPE_API_KEY="sk-your-dashscope-key"

# 微信订阅消息模板 ID（微信公众平台申请）
WX_NOTIFY_TPL_LOW_STATS="your_template_id"

# 服务端口
PORT=3000
NODE_ENV=development
