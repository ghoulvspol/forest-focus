// prisma/schema.prisma
// 与 db/schema.sql 保持一致，新增 Prisma 关系定义

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── 用户 ────────────────────────────────────────────────
model User {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  openId        String   @unique @map("open_id") @db.VarChar(64)
  // 预留字段，TODO 2：扩展到多端时做 OpenID→UnionID 迁移
  unionId       String?  @map("union_id") @db.VarChar(64)
  nickname      String   @default("") @db.VarChar(64)
  avatarUrl     String   @default("") @map("avatar_url") @db.VarChar(512)
  notifyEnabled Boolean  @default(false) @map("notify_enabled")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pet        Pet?
  notifyLogs NotifyLog[]

  @@index([unionId])
  @@map("users")
}

// ─── 宠物 ────────────────────────────────────────────────
model Pet {
  id      Int        @id @default(autoincrement()) @db.UnsignedInt
  userId  Int        @unique @map("user_id") @db.UnsignedInt // MVP：一人一宠
  name    String     @db.VarChar(32)
  species PetSpecies @default(cat)

  originalImageUrl String      @default("") @map("original_image_url") @db.VarChar(512)
  stylizedImageUrl String      @default("") @map("stylized_image_url") @db.VarChar(512)
  imageStyle       String      @default("") @map("image_style") @db.VarChar(32)
  imageStatus      ImageStatus @default(pending) @map("image_status")
  imageUpdatedAt   DateTime?   @map("image_updated_at")

  // stats 存 JSON：{ satiety, cleanliness, happiness } 均 ∈ [5, 100]
  // 读取时用 parseStats() 做 schema 校验 + 默认值兜底（CRITICAL 修复）
  stats Json @default("{\"satiety\":100,\"cleanliness\":100,\"happiness\":100}")

  lastCronAt DateTime @default(now()) @map("last_cron_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyInteractions DailyInteraction[]
  notifyLogs        NotifyLog[]

  @@map("pets")
}

enum PetSpecies {
  cat
  dog
  other
}

// image_status 状态机：
//   pending → processing（AI 调用中）→ done（完成）
//                                     → failed（超时/失败，可重试）
enum ImageStatus {
  pending
  processing
  done
  failed
}

// ─── 每日互动记录 ─────────────────────────────────────────
model DailyInteraction {
  id               Int             @id @default(autoincrement()) @db.UnsignedInt
  petId            Int             @map("pet_id") @db.UnsignedInt
  interactionType  InteractionType @map("interaction_type")
  interactionDate  DateTime        @map("interaction_date") @db.Date
  count            Int             @default(1) @db.UnsignedTinyInt
  statsDelta       Json?           @map("stats_delta")
  lastInteractedAt DateTime        @default(now()) @map("last_interacted_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([petId, interactionType, interactionDate])
  @@index([petId, interactionDate])
  @@map("daily_interactions")
}

enum InteractionType {
  feed
  pet_action
  play
}

// ─── 微信推送日志 ─────────────────────────────────────────
model NotifyLog {
  id            Int        @id @default(autoincrement()) @db.UnsignedInt
  userId        Int        @map("user_id") @db.UnsignedInt
  petId         Int        @map("pet_id") @db.UnsignedInt
  notifyType    NotifyType @default(low_stats) @map("notify_type")
  sentAt        DateTime   @default(now()) @map("sent_at")
  statsSnapshot Json?      @map("stats_snapshot")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet  Pet  @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, notifyType, sentAt])
  @@index([userId, sentAt])
  @@map("notify_logs")
}

enum NotifyType {
  low_stats
  welcome
  daily_remind
}
