<!-- pages/profile/profile.wxml — 个人中心 -->
<view class="page-container">

  <!-- 用户信息 -->
  <view class="card user-card">
    <image src="{{user.avatarUrl || '/images/default-avatar.png'}}"
           class="user-avatar" mode="aspectFill" />
    <view class="user-info">
      <text class="user-name">{{user.nickname || '宠物主人'}}</text>
      <text class="user-sub">{{pet ? pet.name + ' 的主人' : '还没有数字宠物'}}</text>
    </view>
  </view>

  <!-- 通知设置 -->
  <view class="card">
    <view class="setting-row" bindtap="toggleNotify">
      <text class="setting-label">🔔 宠物状态提醒</text>
      <switch checked="{{notifyEnabled}}" color="#FF8FAB" bindchange="toggleNotify" />
    </view>
    <text class="setting-hint">开启后，宠物难过时会通过微信通知提醒你</text>
  </view>

  <!-- 宠物管理 -->
  <view wx:if="{{pet}}" class="card">
    <view class="section-title">宠物管理</view>
    <view class="setting-row" bindtap="goUpload">
      <text class="setting-label">更换宠物照片</text>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="card">
    <view class="section-title">关于</view>
    <view class="setting-row">
      <text class="setting-label">版本</text>
      <text class="setting-value">v1.0.0</text>
    </view>
  </view>

</view>
