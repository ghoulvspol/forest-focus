/* pages/index/index.wxss */

.pet-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 32rpx;
}

/* 宠物头像容器 */
.pet-avatar-wrap {
  position: relative;
  width: 280rpx;
  height: 280rpx;
}

.pet-avatar {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  border: 6rpx solid var(--color-primary-lt);
  box-shadow: 0 8rpx 32rpx rgba(255, 143, 171, 0.25);
  transition: transform 0.2s;
}

/* 情绪驱动的轻微动画 */
.pet-avatar.happy  { animation: pet-bounce 2s ease-in-out infinite; }
.pet-avatar.normal { }
.pet-avatar.sad    { animation: pet-droop  3s ease-in-out infinite; }

@keyframes pet-bounce {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-8rpx); }
}

@keyframes pet-droop {
  0%, 100% { transform: rotate(0deg); }
  50%      { transform: rotate(-3deg); }
}

/* AI 处理中 / 失败遮罩 */
.pet-avatar-overlay {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--color-text-sub);
  gap: 8rpx;
}

.overlay-error { background: rgba(255, 245, 247, 0.9); }

.retry-text {
  color: var(--color-primary);
  font-weight: 600;
  text-decoration: underline;
  margin-top: 4rpx;
}

.pet-info {
  margin-top: 24rpx;
  text-align: center;
}

.pet-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}

.pet-mood {
  display: block;
  font-size: 26rpx;
  margin-top: 8rpx;
}
.pet-mood.happy  { color: #52C41A; }
.pet-mood.normal { color: #FFB347; }
.pet-mood.sad    { color: var(--color-danger); }

/* 互动按钮网格 */
.interact-grid {
  display: flex;
  gap: 24rpx;
}

.interact-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  border-radius: 20rpx;
  border: 2rpx solid var(--color-border);
  transition: opacity 0.15s;
}

.interact-btn:active { opacity: 0.7; }

.interact-btn.disabled {
  background: transparent !important;
  border-color: var(--color-border) !important;
  opacity: 0.4;
}

.interact-emoji { font-size: 48rpx; }

.interact-label {
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.interact-count {
  font-size: 22rpx;
  margin-top: 4rpx;
  opacity: 0.8;
}
