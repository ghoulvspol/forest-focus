/* pages/upload/upload.wxss */

.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx 16rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-sub);
}

.step.active { color: var(--color-primary); }

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-sub);
}

.step.active .step-dot {
  background: var(--color-primary);
  color: #FFFFFF;
}

.step-line {
  flex: 1;
  height: 2rpx;
  background: var(--color-border);
  margin: 0 16rpx;
  margin-bottom: 24rpx;
}

.upload-hint {
  font-size: 26rpx;
  color: var(--color-text-sub);
  text-align: center;
  margin-bottom: 32rpx;
}

.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  border: 3rpx dashed var(--color-border);
  border-radius: 20rpx;
  gap: 16rpx;
}

.upload-area-text {
  font-size: 28rpx;
  color: var(--color-text);
}

.upload-area-sub {
  font-size: 22rpx;
  color: var(--color-text-sub);
}

.preview-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.preview-img {
  width: 300rpx;
  height: 300rpx;
  border-radius: 20rpx;
  border: 4rpx solid var(--color-primary-lt);
}

.reselect-btn { align-self: center; }

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: 32rpx;
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.picker-display {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
  padding-right: 8rpx;
}

.btn-loading {
  display: flex;
  align-items: center;
}

.error-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF1F1;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--color-danger);
}

.error-retry {
  padding: 12rpx 24rpx !important;
  font-size: 24rpx !important;
  color: var(--color-danger) !important;
  border-color: var(--color-danger) !important;
}

/* Step 2：风格选择 */
.style-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.style-item {
  position: relative;
  width: calc(50% - 12rpx);
  border-radius: 16rpx;
  border: 4rpx solid transparent;
  overflow: hidden;
  transition: border-color 0.15s;
}

.style-item.selected {
  border-color: var(--color-primary);
}

.style-preview {
  width: 100%;
  height: 240rpx;
  display: block;
}

.style-name {
  display: block;
  text-align: center;
  padding: 12rpx;
  font-size: 26rpx;
}

.style-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

/* Step 3：确认头像 */
.avatar-confirm-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.avatar-confirm {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid var(--color-primary-lt);
}

.name-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  padding: 0 8rpx;
}
